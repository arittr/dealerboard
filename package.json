{
  "name": "stream-deck-agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:core": "bun build --compile --minify --outfile dist/stream-deck-agents src/core/cli.ts",
    "build:plugin": "rollup --config",
    "build": "bun run typecheck && bun run build:core && bun run build:plugin",
    "pack:plugin": "bun ./node_modules/@elgato/cli/bin/streamdeck.mjs validate com.drewritter.stream-deck-agents.sdPlugin && bun ./node_modules/@elgato/cli/bin/streamdeck.mjs pack com.drewritter.stream-deck-agents.sdPlugin --output dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}
