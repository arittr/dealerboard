{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dealerboard",
  "version": "1.0.0",
  "identifier": "com.drewritter.dealerboard.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dealerboard",
        "decorations": false,
        "resizable": true,
        "width": 1280,
        "height": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
