<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.drewritter.stream-deck-agents</string>
	<key>ProgramArguments</key>
	<array>
		<string>__STREAM_DECK_AGENTS_EXECUTABLE__</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__STREAM_DECK_AGENTS_LOGS_DIRECTORY__/daemon.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__STREAM_DECK_AGENTS_LOGS_DIRECTORY__/daemon.stderr.log</string>
</dict>
</plist>
